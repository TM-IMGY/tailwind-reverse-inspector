{
  "manifest_version": 3,
  "name": "Tailwind Reverse Inspector",
  "version": "0.1.0",
  "description": "Click any element on any page and instantly get the matching Tailwind CSS utility classes.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Tailwind Reverse Inspector — click to inspect this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://extensionpay.com/*"],
      "js": ["extpay-relay.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["activeTab", "scripting", "storage"],
  "minimum_chrome_version": "110"
}
